{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "feeless-api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "server:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "5001"
      ],
      "port": 5001,
      "url": "http://127.0.0.1:5001"
    },
    {
      "name": "feeless-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/serve-fast.sh"
      ],
      "env": {
        "FAST_PORT": "51367"
      },
      "port": 51367
    },
    {
      "name": "feeless-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "craco",
        "start"
      ],
      "env": {
        "PORT": "51366",
        "BROWSER": "none"
      },
      "port": 51366,
      "cwd": "frontend"
    }
  ]
}
