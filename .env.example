# Public client configuration for the approved, non-custodial Meta Launch flow.
# The provider endpoint must prepare unsigned Solana transactions at POST /prepare.
REACT_APP_LAUNCH_API_URL=
REACT_APP_LAUNCH_PROVIDER_NAME=
REACT_APP_LAUNCH_PROVIDER_APPROVED=false
REACT_APP_SOLANA_RPC_URL=
# REACT_APP_LAUNCH_RPC_URL is accepted as a backwards-compatible RPC name.
REACT_APP_LAUNCH_NETWORK=Solana mainnet-beta